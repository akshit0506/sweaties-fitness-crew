# Copy to .env.local. Read by the app (lib/supabase/*, src/proxy.ts). See
# SUPABASE_SETUP.md for local dev and DEPLOYMENT.md for production values.
#
# No service-role key needed: sign-up and group creation are self-serve
# (see supabase/migrations/20260801100000_groups.sql).

# Studio → Project Settings → API. For local dev, `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
